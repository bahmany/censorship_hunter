# Development Dockerfile for Hunter Web UI
# Uses Next.js dev mode with Fast Refresh (hot reload)
FROM node:18-alpine

WORKDIR /app

# Copy package files and install deps (cached layer)
COPY package*.json ./
RUN npm install

# Source code is mounted at runtime via docker-compose volumes
# Next.js dev server provides hot module replacement

EXPOSE 3000

ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_PUBLIC_BACKEND_HOST=hunter-backend
ENV NEXT_PUBLIC_WS_STATUS_PORT=7802
ENV NEXT_PUBLIC_WS_COMMAND_PORT=7801
ENV NEXT_PUBLIC_API_PORT=7801

CMD ["npm", "run", "dev"]
