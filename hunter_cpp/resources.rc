// resources.rc — Windows VERSIONINFO + application manifest for hunter.exe.
//
// Without this, the linked binary carries no .rsrc resources at all: no
// version info (blank "Details" tab in Explorer -> Properties), and no
// embedded manifest (huntercensor.exe.manifest sat unused in the repo).
// A binary with zero version/manifest resources looks more anomalous to
// both a human and to Defender/SmartScreen heuristics than one that
// declares itself properly, so this fixes both at once.

#include <winuser.h>

// GLFW's Win32 backend specifically looks for an icon resource named
// "GLFW_ICON" and uses it automatically for both the window/taskbar icon at
// runtime and (as the first/only icon resource in the file) the icon
// Explorer shows for hunter.exe — one resource, both places, no
// glfwSetWindowIcon() call needed. Must come before other resources so
// Explorer picks it as the file's default icon.
GLFW_ICON ICON "hunter.ico"

1 RT_MANIFEST "huntercensor.exe.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Hunter Project"
            VALUE "FileDescription", "Hunter Censorship Circumvention Tool"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "hunter"
            VALUE "OriginalFilename", "hunter.exe"
            VALUE "ProductName", "Hunter"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
